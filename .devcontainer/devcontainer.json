{
	"name": "backtesting-bybit-bot",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	"containerEnv": {
	  "PIP_DISABLE_PIP_VERSION_CHECK": "1",
	  "PYTHONDONTWRITEBYTECODE": "1",
	  "MPLCONFIGDIR": "/tmp/matplotlib"
	},
	"mounts": [
	  "source=${localEnv:USERPROFILE}\\.cache\\pip,target=/home/vscode/.cache/pip,type=bind"
	],
	"postCreateCommand": "pip install -r requirements.txt && if ls dist/*.whl 1> /dev/null 2>&1; then pip install dist/*.whl; fi",
	"forwardPorts": [8888],
	"customizations": {
	  "vscode": {
		"extensions": ["ms-toolsai.jupyter", "ms-python.python"],
		"settings": {
		  "python.defaultInterpreterPath": "/usr/local/bin/python",
		  "python.formatting.provider": "black"
		}
	  }
	}
  }